# Phyllo-ViT 2.0 environment (copy values into your shell or system environment; the backend does not read this file by itself)
# Free key from https://explore.openaq.org/register - needed only for ambient air-quality lookup
OPENAQ_API_KEY=
# Optional
# OPENAQ_RADIUS_M=25000
# PHYLLO_CORS_ORIGINS=https://your-frontend.example
# PHYLLO_LOAD_AQI_MODEL=1
# Frontend: frontend/.env.local -> NEXT_PUBLIC_API_URL=http://127.0.0.1:8000